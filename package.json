{
  "name": "hive-invest",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Hive Invest \u2014 a long-term main account and a small rule-based Bitcoin trading account, on Cloudflare.",
  "scripts": {
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 migrations apply hive-invest --local",
    "db:init": "wrangler d1 migrations apply hive-invest --remote",
    "deploy": "wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply hive-invest --remote && wrangler deploy",
    "logs": "wrangler tail",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && wrangler deploy --dry-run --outdir .wrangler/dry",
    "backfill": "node scripts/backfill.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}